  test('Enroll Course with multiple student', async ({ page }) => {
    await page.goto(`${testUrl}/@/${courseName}`)
    await page.waitForTimeout(3000)

    // enroll / open details course
    await expect(page.getByTestId('enroll-btn').first()).not.toBeEmpty()
    await expect(page.locator('h1').filter({ hasText: courseName })).not.toBeEmpty()
    await page.getByTestId('enroll-btn').first().click()
    await page.waitForTimeout(3000)

    await page
      .locator('button#option')
      .filter({ hasText: `regular0${className}` })
      .filter({ hasText: 'Regular' })
      .first()
      .click()
    await page.locator('button#option').first().click()
    await page.locator('#numberOfApplicant').fill('2')
    await page.locator('button#option').first().click()

    // application form
    await page.locator("input[name='applicant[0].Name']").fill(studentName)
    await page.locator("input[name='applicant[0].Email']").fill(studentEmail)
    await page.locator("input[id='phone']").fill(studentPhone)

    await page.getByTestId('next-applicant').first().click()

    await page.locator("input[name='applicant[1].Name']").fill(studentName2)
    await page.locator("input[name='applicant[1].Email']").fill(studentEmail2)
    await page.locator("input[id='phone']").fill(studentPhone2)

    await page.getByRole('button', { name: 'Confirm' }).click()

    const totalPrice = `${Number(classPrice) * 2}` // 2 classes

    // confirm form
    await expect(page.getByText('The price is not final yet.')).toBeVisible()
    await expect(page.getByText(classPrice).first()).toBeVisible()
    await expect(page.getByText(totalPrice).first()).toBeVisible()
    await page.getByRole('button', { name: 'Register and proceed to payment' }).click()
    await page.waitForTimeout(5000)

    // upload-receipt
    await expect(page.getByText('Please complete the payment to secure the seat.')).toBeVisible()
    await expect(page.getByText(studentName).first()).toBeVisible()
    await expect(page.getByText(studentEmail)).toBeVisible()
    await expect(page.getByText(courseName).first()).toBeVisible()
    await expect(page.getByText(classPrice).first()).toBeVisible()
    await expect(page.getByText(totalPrice).first()).toBeVisible()
  })

  test('Enroll Course with multiple class: 3 regular classes', async ({ page }) => {
    await page.goto(`${testUrl}/@/${courseName}`)
    await page.waitForTimeout(3000)

    // enroll / open details course
    await expect(page.getByTestId('enroll-btn').first()).not.toBeEmpty()
    await expect(page.locator('h1').filter({ hasText: courseName })).not.toBeEmpty()
    await page.getByTestId('enroll-btn').first().click()
    await page.waitForTimeout(3000)

    // enable multi class
    await expect(page.locator('#selected-multi-class')).not.toBeVisible()
    await page.getByTestId('multiple-class-switch').locator('button').click()
    await expect(page.locator('#selected-multi-class')).toBeVisible()

    for (let i = 0; i < 3; i++) {
      await page
        .locator('button#option')
        .filter({ hasText: `regular${i}${className}` })
        .filter({ hasText: 'Regular' })
        .first()
        .click()
      await page.locator('button#option').first().click()
      await page.locator('button#option').first().click()
    }

    // proceed
    await page.getByTestId('proceed-btn').click()

    // application form
    await page.locator("input[name='applicant[0].Name']").fill(studentName)
    await page.locator("input[name='applicant[0].Email']").fill(studentEmail)
    await page.locator("input[id='phone']").fill(studentPhone)
    await page.getByRole('button', { name: 'Confirm' }).click()

    const totalPrice = `${Number(classPrice) * 3}` // 3 classes

    // confirm form
    await expect(page.getByText('The price is not final yet.')).toBeVisible()
    await expect(page.getByText(classPrice).first()).toBeVisible()
    await expect(page.getByText(totalPrice).first()).toBeVisible()
    await page.getByRole('button', { name: 'Register and proceed to payment' }).click()
    await page.waitForTimeout(5000)

    // upload-receipt
    await expect(page.getByText('Please complete the payment to secure the seat.')).toBeVisible()
    await expect(page.getByText(studentName).first()).toBeVisible()
    await expect(page.getByText(studentEmail)).toBeVisible()
    await expect(page.getByText(courseName).first()).toBeVisible()
    await expect(page.getByText(classPrice).first()).toBeVisible()
    await expect(page.getByText(totalPrice).first()).toBeVisible()
  })

  test('Enroll Course with multiple class: regular, event, recurring + coupon', async ({
    page,
  }) => {
    await page.goto(`${testUrl}/@/${courseName}`)
    await page.waitForTimeout(3000)

    // enroll / open details course
    await expect(page.getByTestId('enroll-btn').first()).not.toBeEmpty()
    await expect(page.locator('h1').filter({ hasText: courseName })).not.toBeEmpty()
    await page.getByTestId('enroll-btn').first().click()
    await page.waitForTimeout(3000)

    // enable multi class
    await expect(page.locator('#selected-multi-class')).not.toBeVisible()
    await page.getByTestId('multiple-class-switch').locator('button').click()
    await expect(page.locator('#selected-multi-class')).toBeVisible()

    // data 1: select options
    await page
      .locator('button#option')
      .filter({ hasText: className })
      .filter({ hasText: 'Regular' })
      .first()
      .click()
    // data 1: select timeslot
    await page.locator('button#option').first().click()
    // data 1: select price
    await page.locator('button#option').first().click()

    // data 2: select options
    await page
      .locator('button#option')
      .filter({ hasText: className })
      .filter({ hasText: 'Event' })
      .first()
      .click()
    // data 2: select timeslot
    await page.locator('button#option').first().click()

    // data 3: select options
    await page
      .locator('button#option')
      .filter({ hasText: className })
      .filter({ hasText: 'Recurring' })
      .first()
      .click()

    // data 3: select weekday
    await page.locator('button#option').first().click()

    // data 3: select first lesson
    await page.locator('button#option').first().click()

    // data 3: select price
    await page.locator('button#option').first().click()

    // proceed
    await page.getByTestId('proceed-btn').click()

    // application form
    await page.locator("input[name='applicant[0].Name']").fill(studentName)
    await page.locator("input[name='applicant[0].Email']").fill(studentEmail)
    await page.locator("input[id='phone']").fill(studentPhone)
    await page.getByRole('button', { name: 'Confirm' }).click()

    const totalPrice = `${Number(classPrice) * 3}` // 3 classes

    // confirm form
    await expect(page.getByText('The price is not final yet.')).toBeVisible()
    await expect(page.getByText(classPrice).first()).toBeVisible()
    await expect(page.getByText(totalPrice).first()).toBeVisible()
    await page.getByRole('button', { name: 'Register and proceed to payment' }).click()
    await page.waitForTimeout(5000)

    // upload-receipt
    await expect(page.getByText('Please complete the payment to secure the seat.')).toBeVisible()
    await expect(page.getByText(studentName).first()).toBeVisible()
    await expect(page.getByText(studentEmail)).toBeVisible()
    await expect(page.getByText(courseName).first()).toBeVisible()
    await expect(page.getByText(classPrice).first()).toBeVisible()
    await expect(page.getByText(totalPrice).first()).toBeVisible()
    await page.waitForTimeout(1000)

    // input coupon
    await page.locator('#couponCode').fill(`${timestamp}1`)
    await page.getByTestId('check-coupon-btn').click()
    await page.waitForTimeout(1000)
    // check after coupon is applied
    await expect(
      page.getByText(`The coupon is successfully applied: ${timestamp}1`).first()
    ).toBeVisible()
    await expect(page.locator('#price-0').first()).toBeVisible()
  })

